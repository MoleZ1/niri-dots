* {
	border: none;
	border-radius: 0;
	font-family: "Iosevka Nerd Font";
	font-size: 18px;
	font-weight: bold;

	min-height: 0;
	margin: 0;
	padding: 0;
}

window#waybar {
	background: transparent;
}

#waybar>box {
	margin: 18px 34px 7px 34px;
}

.modules-left {
	background: #FFFFFF;
	border: 2px solid #000000;
	border-radius: 18px;
	padding: 5px 12px;
	box-shadow: 3px 4px #666666;
}

.modules-center {
	background: #FFFFFF;
	border: 2px solid #000000;
	border-radius: 18px;
	padding: 5px 12px;
	box-shadow: 3px 4px #666666;
}

.modules-right {
	background: #FFFFFF;
	border: 2px solid #000000;
	border-radius: 18px;
	padding: 5px 12px;
	box-shadow: 3px 4px #666666;
}

tooltip {
	background: #000000;
	color: #FFFFFF;
}

#battery {
	color: #000000;
	padding: 0 15px 0 0;
}

#network {
	color: #000000;
	padding: 0 15px 0 0;
}

#clock {
	color: #000000;
}

#pulseaudio {
	color: #000000;
	padding: 0 11px 0 0;
}

#workspaces {
	padding: 0 2px 0 0;
}

#workspaces button {
	color: #666666;
}

#workspaces button.active {
	color: #000000;
}

#backlight {
	color: #000000;
	padding: 0 8px 0 0;
}

#mpris {
	color: #000000;
}
