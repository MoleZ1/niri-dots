{
	"position": "top",
	"spacing": 2,
	"reload_style_on_change": true,
	"modules-left": [
		"battery",
		"network",
		"clock"
	],
	"modules-center": [
		"pulseaudio",
		"niri/workspaces",
		"backlight"
	],
	"modules-right": [
		"mpris"
	],
	// Modulesl left
	"battery": {
		"weighted-average": true,
		"states": {
			"warning": 25,
			"critical": 15
		},
		"format": "{capacity}% {icon}",
		"format-icons": [
			"",
			"",
			"",
			"",
			""
		],
		"max-length": 30
	},
	"network": {
		"interface": "wlp3s0",
		"format": "{ifname}",
		"format-wifi": "{frequency} GHz ",
		"format-ethernet": "{ipaddr}/{cidr} 󰊗",
		"format-disconnected": "N/C",
		"tooltip-format": "{ifname} via {gwaddr} 󰊗",
		"tooltip-format-wifi": "{essid} ({signalStrength}%) ",
		"tooltip-format-ethernet": "{ifname} ",
		"tooltip-format-disconnected": "Disconnected",
		"max-length": 50
	},
	"pulseaudio": {
		"format": "{volume}% {icon}",
		"format-bluetooth": "{volume}% {icon}",
		"format-muted": "N/S ",
		"format-icons": {
			"alsa_output.pci-0000_00_1f.3.analog-stereo": "",
			"alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
			"headphone": "",
			"hands-free": "",
			"headset": "",
			"phone": "",
			"phone-muted": "",
			"portable": "",
			"car": "",
			"default": [
				"",
				""
			]
		},
		"scroll-step": 1,
		"on-click": "pavucontrol",
		"ignored-sinks": [
			"Easy Effects Sink"
		],
		"tooltip": false
	},
	"backlight": {
		"device": "intel_backlight",
		"format": "{percent}% {icon}",
		"format-icons": [
			"",
			""
		],
		"tooltip": false
	},
	// Modules center
	"niri/workspaces": {
		"format": "{icon}",
		"workspace-taskbar": {
			"enable": true,
			"icon-size": 18
		}
	},
	// Modules right
	"mpris": {
		"interval": 1,
		"format": "{player_icon} {artist} - {title}",
		"format-paused": "{status_icon} {artist} - {title}",
		"tooltip-format": "{position} / {length}",
		"player-icons": {
			"default": "▶",
			"mpv": "🎵"
		},
		"status-icons": {
			"paused": "⏸"
		},
		"ignored-players": [
			"firefox"
		]
	},
	"clock": {
		"interval": 60,
		"tooltip": true,
		"format": "{:%H:%M}",
		"tooltip-format": "{:%Y-%m-%d}"
	}
}
