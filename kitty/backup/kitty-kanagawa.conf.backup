# FONT
font_family				family="Adwaita Mono"
bold_font					auto
italic_font				auto
bold_italic_font	auto
font_size					11
disable_ligatures always

# SHELL
shell							zsh
shell_integration disabled

# CURSOR
cursor_shape					 block 
cursor_shape_unfocused underline
cursor_blink_interval	 0
cursor_trail					 1
cursor_trail_decay		 0.1 0.3

# SCROLLBACK
scrollback_lines							3000
scrollbar_interactive					no
scrollbar_handle_opacity      0
scrollbar_track_opacity       0
scrollbar_track_hover_opacity 0

# MOUSE
mouse_hide_wait			 -1
url_style						 curly
underline_hyperlinks always

# TERMINAL BELL
enable_audio_bell no

# LAYOUT
remember_window_size	no
initial_window_width  640
initial_window_height 400
window_padding_width	2

# WINDOW
background_image				none
background_opacity			0.80
background_blur					1
confirm_os_window_close 0

# COLORS
background					 #181616
foreground					 #C5C9C5
selection_background #2D4F67
selection_foreground #C8C093

url_color						 #72A7BC
cursor							 #C8C093

# Black
color0							 #0D0C0C
color8							 #A6A69C

# Red
color1							 #C4746E
color9							 #E46876

# Green
color2							 #8A9A7B
color10							 #87A987

# Yellow
color3							 #C4B28A
color11							 #E6C384

# Blue
color4							 #8BA4B0
color12							 #7FB4CA

# Magenta
color5							 #A292A3
color13							 #938AA9

# Aqua
color6							 #8EA4A2
color14							 #7AA89F

# White
color7							 #C8C093
color15							 #C5C9C5
