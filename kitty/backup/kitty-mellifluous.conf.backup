# FONT
font_family       family="Iosevka Nerd Font Mono"
bold_font         auto
italic_font       auto
bold_italic_font  auto
font_size         12.5
disable_ligatures yes

# SHELL
shell             zsh
shell_integration disabled

# CURSOR
cursor_shape					 block 
cursor_shape_unfocused underline
cursor_blink_interval	 0
cursor_trail					 1
cursor_trail_decay		 0.1 0.3

# SCROLLBACK
scrollback_lines							3000
scrollbar_interactive					no
scrollbar_handle_opacity      0
scrollbar_track_opacity       0
scrollbar_track_hover_opacity 0

# MOUSE
mouse_hide_wait			 -1
url_style						 curly
underline_hyperlinks always

# TERMINAL BELL
enable_audio_bell no

# LAYOUT
remember_window_size	no
initial_window_width  640
initial_window_height 400
window_padding_width	2

# WINDOW
background_image              none
background_opacity            0.8
scrollbar_handle_opacity      0
scrollbar_track_opacity       0
scrollbar_track_hover_opacity 0
confirm_os_window_close       0

# Theme Mellifluous
background           #1A1A1A
foreground           #DADADA
selection_background #2D2D2D
selection_foreground #DADADA

cursor               #BFAD9E
cursor_text_color    #1A1A1A

url_color            #A8A1BE

# Black
color0							 #1A1A1A
color8							 #4D4D4D

# Red
color1							 #BE7C7D
color9							 #C95954

# Green
color2							 #939374
color10							 #828040

# Yellow
color3							 #CBAA89
color11							 #A6794C

# Blue
color4							 #938CA8
color12							 #5A6599

# Magenta
color5							 #A3869F
color13							 #9C6995

# Cyan
color6							 #7B9796
color14							 #74A39E

# White
color7							 #AEAEAE
color15							 #DADADA
